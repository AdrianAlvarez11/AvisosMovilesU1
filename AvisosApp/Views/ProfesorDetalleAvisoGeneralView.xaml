<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AvisosApp.Views.ProfesorDetalleAvisoGeneralView"
             Title="" Background="#dad7cd">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cerrar sesión" Order="Secondary" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="auto, auto, *">
        <Button Text="← Regresar" Command="{Binding RegresarMaestroCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Start" FontFamily="Verdana" FontAttributes="Bold" Margin="10,10,0,0"/>

        <Border Grid.Row="1" Margin="10" Padding="10">
            <Grid RowDefinitions="auto,*,auto">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <Label FontFamily="Verdana" Text="{Binding SeleccionadoGeneral.Titulo}" FontAttributes="Bold" FontSize="16" TextColor="Black"></Label>
                    <Button FontFamily="Verdana" Grid.Column="1" Text="Eliminar" BackgroundColor="#3a5a40" TextColor="White" FontSize="12" HorizontalOptions="End" Command="{Binding EliminarAvisosGeneralesCommand}" CommandParameter="{Binding SeleccionadoGeneral.Id}"></Button>
                </Grid>
                <ScrollView Grid.Row="1">
                    <Label HorizontalTextAlignment="Justify" FontFamily="Verdana" Text="{Binding SeleccionadoGeneral.Contenido}" FontSize="13" TextColor="Black" CharacterSpacing="2"></Label>
                </ScrollView>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" RowDefinitions=".1*,.1*" RowSpacing="10" Margin="0,10,0,0">
                    <Label FontFamily="Verdana" Text="Fecha de Creación:" FontSize="12" TextColor="Gray"></Label>
                    <Label FontFamily="Verdana" Grid.Column="1" Text="{Binding SeleccionadoGeneral.FechaEnviado, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="12" TextColor="Gray" HorizontalOptions="End"></Label>
                    <Label FontFamily="Verdana" Grid.Row="1" Text="Expira:" FontSize="12" TextColor="Gray"></Label>
                    <Label FontFamily="Verdana" Grid.Row="1" Grid.Column="1" Text="{Binding SeleccionadoGeneral.FechaExpira, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="12" TextColor="Gray" HorizontalOptions="End"></Label>
                </Grid>
            </Grid>
        </Border>
        <ScrollView Grid.Row="2" Margin="10">
            <VerticalStackLayout>
                <Label FontFamily="Verdana" Text="Alumnos que han leído:" FontAttributes="Bold" FontSize="14" TextColor="Black" IsVisible="{Binding HayLeidosGenerales}"></Label>

                <CollectionView ItemsSource="{Binding SeleccionadoGeneral.Leidos}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" TextColor="Black"></Label>
                                    <Label Grid.Column="1" Text="{Binding NumControl}" TextColor="Black"></Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label FontFamily="Verdana" Text="Alumnos pendientes de lectura:" FontAttributes="Bold" FontSize="14" TextColor="Black" IsVisible="{Binding HayPendientesGenerales}"></Label>

                <CollectionView ItemsSource="{Binding SeleccionadoGeneral.PendientesLectura}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" TextColor="Black"></Label>
                                    <Label Grid.Column="1" Text="{Binding NumControl}" TextColor="Black"></Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
