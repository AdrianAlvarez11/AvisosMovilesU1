<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AvisosApp.Views.RegisterAlumnoView"
             Title="" Background="#dad7cd">
    <Grid>
        <Button Text="← Regresar" Command="{Binding RegresarMaestroCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Start" VerticalOptions="Start" FontFamily="Verdana" FontAttributes="Bold" Margin="10,10,0,0"/>
        <VerticalStackLayout VerticalOptions="Center">
            <Label FontFamily="Verdana" FontAttributes="Bold" TextColor="Black" Text="Registrar" FontSize="24" HorizontalOptions="Center" Margin="0,0,0,50" />
            <Entry FontFamily="Verdana" Text="{Binding Alumno.Nombre}" Placeholder="Nombre" Background="#a3b18a"  Margin="10, 10, 10, 0"></Entry>
            <Entry FontFamily="Verdana" Text="{Binding Alumno.NumControl}" Placeholder="Numero de control" Background="#a3b18a"  Margin="10, 10, 10, 0"></Entry>
            <Entry FontFamily="Verdana" Text="{Binding Alumno.Contrasena}" Placeholder="Contraseña" Background="#a3b18a" Margin="10, 10, 10, 0"></Entry>
            <!--<Grid ColumnDefinitions="*, auto" Margin="10, 10, 10, 0" >
                <Label FontFamily="Verdana" TextColor="Black" Text="¿Ya estas registrado?" VerticalOptions="Center"></Label>
                <Button FontFamily="Verdana" Grid.Column="1" Text="Iniciar Sesión" TextColor="#344e41" Padding="0,0,5,0" Command="{Binding VistaLoginCommand}"
                        BackgroundColor="Transparent" VerticalOptions="Center"></Button>
            </Grid>-->
            <Label Margin="10, 10, 10, 0" FontFamily="Verdana" TextColor="Red" Text="{Binding Error}" IsVisible="{Binding HayError}"></Label>

            <Button Text="Registrar" TextColor="White" Command="{Binding RegistrarAlumnoCommand}" FontFamily="Verdana" Margin="10, 10, 10, 0"></Button>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
