<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AvisosApp.Views.ProfesorCrearAvisoPersonalView"
             Title="ProfesorCrearAvisoPersonalView" Background="#FFFBDE">

    <VerticalStackLayout VerticalOptions="Center">
        <Label FontFamily="Verdana" FontAttributes="Bold" TextColor="Black" Text="Crear Aviso Personal" FontSize="24" HorizontalOptions="Center" Margin="0,0,0,50" />
        <Entry FontFamily="Verdana" Placeholder="Titulo" Background="#91C8E4"  Margin="10, 10, 10, 0"></Entry>
        <Entry FontFamily="Verdana" Placeholder="Contenido" Background="#91C8E4" Margin="10, 10, 10, 0"></Entry>
        <Label Margin="10, 10, 10, 0" FontFamily="Verdana" TextColor="Black" Text="Introduce datos validos"></Label>
        <Button Text="Crear" FontFamily="Verdana" Margin="10, 10, 10, 0"></Button>
    </VerticalStackLayout>
</ContentPage>