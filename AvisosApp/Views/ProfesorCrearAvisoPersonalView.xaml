<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AvisosApp.Views.ProfesorCrearAvisoPersonalView"
             Title="ProfesorCrearAvisoPersonalView" Background="#dad7cd">

    <Grid RowDefinitions="auto, *">
        <Button Text="← Cancelar / Regresar" Command="{Binding RegresarMaestroCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Start" FontFamily="Verdana" FontAttributes="Bold" Margin="10,10,0,0"/>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center">
            <Label FontFamily="Verdana" FontAttributes="Bold" TextColor="Black" Text="Crear Aviso Personal" FontSize="24" HorizontalOptions="Center" Margin="0,0,0,50" />
            <Entry FontFamily="Verdana" Placeholder="Titulo" Background="#a3b18a" Text="{Binding AvisoPersonal.Titulo}"  Margin="10, 10, 10, 0"></Entry>
            <Entry FontFamily="Verdana" Placeholder="Contenido" Background="#a3b18a" Text="{Binding AvisoPersonal.Contenido}" Margin="10, 10, 10, 0"></Entry>
            <Label Margin="10, 10, 10, 0" FontFamily="Verdana" TextColor="Red" Text="{Binding Error}" IsVisible="{Binding HayError}"></Label>
            <Button Text="Crear" FontFamily="Verdana" Command="{Binding CrearAvisoPersonalCommand}" Margin="10, 10, 10, 0"></Button>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
