<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AvisosApp.Views.LoginView"
             Title="" Background="#dad7cd">

    <Grid>
        <VerticalStackLayout VerticalOptions="Center">
            <Label FontFamily="Verdana" FontAttributes="Bold" TextColor="Black" Text="Inicia sesión" FontSize="24" HorizontalOptions="Center" Margin="0,0,0,50" />
            <Entry FontFamily="Verdana" Placeholder="Numero de control" Text="{Binding NumControl}" Background="#a3b18a"  Margin="10, 10, 10, 0"></Entry>
            <Entry FontFamily="Verdana" Placeholder="Contraseña" Text="{Binding Contrasena}" Background="#a3b18a" Margin="10, 10, 10, 0" IsPassword="True"></Entry>
            <Grid ColumnDefinitions="*, auto" Margin="10, 10, 10, 0" >
                <Label FontFamily="Verdana" TextColor="Black" Text="¿No tienes cuenta?" VerticalOptions="Center"></Label>
                <Button FontFamily="Verdana" Grid.Column="1" Text="Registrar" Command="{Binding VistaRegistrarCommand}" TextColor="#344e41" Padding="0,0,5,0"
                        BackgroundColor="Transparent" VerticalOptions="Center"></Button>
            </Grid>
            <Label Margin="10, 10, 10, 0" FontFamily="Verdana" TextColor="Red" Text="{Binding Error}" IsVisible="{Binding HayError}"></Label>

            <Button Text="Iniciar sesión" Command="{Binding LoginCommand}" FontFamily="Verdana" Margin="10, 10, 10, 0"></Button>
        </VerticalStackLayout>

        <!-- Loading Overlay -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsBusy}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" />
                <Label Text="Cargando..." TextColor="White" FontFamily="Verdana" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
